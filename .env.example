# Copy to .env and fill in values locally. Never commit .env or real secrets.
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Inbound Facebook Messenger webhook and Aura replies.
# Use fresh credentials from Meta; never commit real secrets.
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=61595323019908
FB_VERIFY_TOKEN=
# Choose a supported Graph API version in your Meta app dashboard, e.g. vXX.X.
META_GRAPH_VERSION=
MESSENGER_DB_PATH=work/messenger.sqlite3
MESSENGER_BACKGROUND_WORKER=true
# Render injects PORT automatically. This value is for local serving.
PORT=5000

# Generate a long random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
ORDER_WEBHOOK_URL=http://127.0.0.1:5000/webhooks/orders
# dry_run prevents courier/Sheets/order-notification effects. Inbound Messenger
# Aura replies still call Gemini and Meta when their credentials are configured.
DELIVERY_MODE=dry_run
ORDER_DB_PATH=work/orders.sqlite3
# Keep false for Render free/ephemeral storage. Set true only after actually
# provisioning and verifying durable order state; this flag creates no storage.
FULFILLMENT_STATE_DURABLE=false
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=5000
API_TIMEOUT_SECONDS=15

# Steadfast merchant credentials
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Pathao merchant credentials and verified store/location IDs.
# Merchant routing metadata can override recipient location IDs per order.
# Do not use one customer's IDs as defaults for every customer's address.
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_STORE_ID=
PATHAO_CITY_ID=
PATHAO_ZONE_ID=
PATHAO_AREA_ID=
PATHAO_ITEM_WEIGHT_KG=

# Google Sheets direct append: existing spreadsheet title Customer Orders BD,
# tab Orders, headers full_name,phone_number,address_line,district,grand_total_bdt.
# Access token must have write permission; renew it before expiry.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Orders!A:E
GOOGLE_SHEETS_ACCESS_TOKEN=
# Production alternative with automatic token renewal: private service-account
# JSON key path. Share Customer Orders BD with the account's client_email.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
# Alternative: a private automation Catch Hook URL. Overrides direct Sheets.
# The automation still must be configured to append to Customer Orders BD.
SHEETS_WEBHOOK_URL=

# Optional outbound aliases; the FB_* credentials above are also accepted.
# Messenger: Page token with pages_messaging, Page ID, supported API version.
# The trusted channel supplies messenger_psid and messenger_last_interaction_at.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
